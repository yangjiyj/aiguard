{
  "name": "portal-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22 <23"
  },
  "description": "JJDGuard 企业 AI 门户的身份归因、员工密钥映射与网关转发服务",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/admin/public','dist/admin/public',{recursive:true})\"",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build",
    "dev": "node --import tsx src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "jose": "^6.2.3",
    "pg": "^8.16.0",
    "prisma": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
