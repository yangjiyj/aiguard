{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yangjiyj/agent-security-platform/contracts/events.v1.schema.json",
  "title": "Agent endpoint event batch v1",
  "type": "object",
  "required": [
    "schema_version",
    "endpoint_id",
    "hookd_version",
    "sent_at",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "events.v1"
    },
    "endpoint_id": {
      "type": "string",
      "pattern": "^ep_[A-Za-z0-9_-]{6,64}$"
    },
    "hookd_version": {
      "type": "string",
      "maxLength": 32
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/Event"
      }
    }
  },
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Decision": {
      "type": "string",
      "enum": [
        "allow",
        "audit",
        "confirm",
        "block"
      ]
    },
    "Mode": {
      "type": "string",
      "enum": [
        "monitor",
        "would_block",
        "block"
      ]
    },
    "ToolType": {
      "type": "string",
      "enum": [
        "system",
        "file",
        "network",
        "database",
        "mcp",
        "skill",
        "agent",
        "browser",
        "other"
      ]
    },
    "Event": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "occurred_at",
        "agent",
        "session",
        "context"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "session.start",
            "session.end",
            "turn.start",
            "turn.end",
            "tool.pre",
            "tool.post",
            "tool.failure",
            "tool.denied",
            "permission.request",
            "subagent.start",
            "subagent.stop",
            "config.change",
            "instructions.loaded",
            "context.compact",
            "asset.snapshot",
            "adapter.health"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "agent": {
          "type": "object",
          "required": [
            "product"
          ],
          "additionalProperties": false,
          "properties": {
            "product": {
              "type": "string",
              "enum": [
                "claude-code",
                "openclaw",
                "opencode",
                "hermes",
                "codex",
                "cursor",
                "vscode",
                "python-sdk",
                "dify",
                "other"
              ]
            },
            "version": {
              "type": "string",
              "maxLength": 64
            },
            "runtime": {
              "type": "string",
              "enum": [
                "cli",
                "ide",
                "gateway",
                "sdk",
                "service"
              ]
            }
          }
        },
        "session": {
          "type": "object",
          "required": [
            "session_id"
          ],
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "type": "string",
              "maxLength": 128
            },
            "parent_session_id": {
              "type": "string",
              "maxLength": 128
            },
            "agent_id": {
              "type": "string",
              "maxLength": 128
            },
            "agent_type": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "turn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt_id": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "context": {
          "type": "object",
          "required": [
            "machine_id",
            "hostname",
            "os_user"
          ],
          "additionalProperties": false,
          "properties": {
            "machine_id": {
              "type": "string",
              "maxLength": 128
            },
            "hostname": {
              "type": "string",
              "maxLength": 255
            },
            "os_user": {
              "type": "string",
              "maxLength": 128
            },
            "cwd_hash": {
              "$ref": "#/$defs/Hash"
            },
            "project_label": {
              "type": "string",
              "maxLength": 64
            },
            "permission_mode": {
              "type": "string",
              "maxLength": 32
            },
            "model": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "tool": {
          "type": "object",
          "required": [
            "tool_use_id",
            "name",
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "tool_use_id": {
              "type": "string",
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "maxLength": 255
            },
            "type": {
              "$ref": "#/$defs/ToolType"
            },
            "mcp_server": {
              "type": "string",
              "maxLength": 128
            },
            "args_hash": {
              "$ref": "#/$defs/Hash"
            },
            "args_len": {
              "type": "integer",
              "minimum": 0
            },
            "args_summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "string",
                  "maxLength": 1024
                },
                "path": {
                  "type": "string",
                  "maxLength": 512
                },
                "paths": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 512
                  }
                },
                "url": {
                  "type": "string",
                  "maxLength": 512
                },
                "sql_kind": {
                  "type": "string",
                  "enum": [
                    "select",
                    "mutation",
                    "ddl",
                    "unknown"
                  ]
                },
                "description": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            },
            "result": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hash": {
                  "$ref": "#/$defs/Hash"
                },
                "len": {
                  "type": "integer",
                  "minimum": 0
                },
                "success": {
                  "type": "boolean"
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "truncated": {
                  "type": "boolean"
                }
              }
            },
            "result_preview": {
              "type": "string",
              "maxLength": 512
            }
          }
        },
        "local_decision": {
          "type": "object",
          "required": [
            "raw",
            "effective",
            "mode",
            "latency_ms",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "raw": {
              "$ref": "#/$defs/Decision"
            },
            "effective": {
              "$ref": "#/$defs/Decision"
            },
            "mode": {
              "$ref": "#/$defs/Mode"
            },
            "rule_id": {
              "type": "string",
              "maxLength": 128
            },
            "reason": {
              "type": "string",
              "maxLength": 256
            },
            "latency_ms": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "enum": [
                "local",
                "server",
                "timeout_fallback",
                "offline_fallback",
                "agent_authorization",
                "agent_approval"
              ]
            },
            "policy_version": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "server_trace_id": {
          "type": "string",
          "maxLength": 128
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user_prompt": {
              "type": "string",
              "maxLength": 65536
            },
            "assistant_text": {
              "type": "string",
              "maxLength": 65536
            },
            "prompt_hash": {
              "$ref": "#/$defs/Hash"
            },
            "prompt_len": {
              "type": "integer",
              "minimum": 0
            },
            "assistant_hash": {
              "$ref": "#/$defs/Hash"
            },
            "assistant_len": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_source": {
              "type": "string",
              "enum": [
                "startup",
                "resume",
                "clear",
                "compact",
                "fork"
              ]
            },
            "end_reason": {
              "type": "string",
              "maxLength": 32
            },
            "stop_reason": {
              "type": "string",
              "maxLength": 32
            },
            "denied_by": {
              "type": "string",
              "enum": [
                "user",
                "hook",
                "policy",
                "unknown"
              ]
            },
            "compact_phase": {
              "type": "string",
              "enum": [
                "pre",
                "post"
              ]
            },
            "error_code": {
              "type": "string",
              "maxLength": 64
            },
            "error_message": {
              "type": "string",
              "maxLength": 512
            }
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "asset_type",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "asset_type": {
                "type": "string",
                "enum": [
                  "model",
                  "mcp_server",
                  "mcp_tool",
                  "skill",
                  "plugin",
                  "instruction_file",
                  "hook",
                  "config"
                ]
              },
              "name": {
                "type": "string",
                "maxLength": 255
              },
              "version": {
                "type": "string",
                "maxLength": 64
              },
              "source": {
                "type": "string",
                "maxLength": 64
              },
              "hash": {
                "$ref": "#/$defs/Hash"
              },
              "present": {
                "type": "boolean"
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "transport": {
                    "type": "string",
                    "enum": [
                      "stdio",
                      "http",
                      "sse"
                    ]
                  },
                  "command": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "url_host": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "env_keys": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  },
                  "path_hash": {
                    "$ref": "#/$defs/Hash"
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "managed",
                      "user",
                      "project",
                      "local",
                      "plugin"
                    ]
                  },
                  "event": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "matcher": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "risk_flags": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 64
                    }
                  }
                }
              }
            }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "queue_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "queue_events": {
              "type": "integer",
              "minimum": 0
            },
            "dropped_events": {
              "type": "integer",
              "minimum": 0
            },
            "last_upload_error": {
              "type": "string",
              "maxLength": 256
            },
            "decide_calls": {
              "type": "integer",
              "minimum": 0
            },
            "decide_timeouts": {
              "type": "integer",
              "minimum": 0
            },
            "policy_version": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
