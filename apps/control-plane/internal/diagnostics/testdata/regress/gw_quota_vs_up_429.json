      ]
    },
    "title_contains": {
      "up_429": [
        "上游"
      ]
    },
    "must_level": {
      "gw_quota": "confirmed",
      "up_429": "confirmed"
    },
    "l3": {
      "must_keywords_any": [
        "额度",
        "配额"
      ],
      "must_keywords_any2": [
        "上游"
      ],
      "title_rules": [
        {
          "match_any": [
            "额度",
            "配额"
          ],
          "title_require": [
            "网关"
          ]
        },
        {
          "match": [
            "限流"
          ],
          "title_require": [
            "上游"
          ]
        }
      ]
    }
