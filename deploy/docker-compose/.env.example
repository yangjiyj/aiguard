# Version stamp exposed by service startup logs and /admin/v1/system/version.
JJD_VERSION=unknown
JJD_COMMIT=
JJD_BUILT_AT=

# Build-time source gate: release requires the clean live origin/main revision;
# candidate requires a clean release/* branch descended from live origin/main.
# The formal release gate remains the default.
OFFLINE_RELEASE_SOURCE_MODE=release
# 产品档位仅允许 gateway（默认）或 agent-platform；未知值启动失败。
PRODUCT_PROFILE=gateway
# gateway 档位固定 JJDGuard/引擎 VERSION，忽略以下覆盖；agent-platform 档位可配置。
# 平台档位未配置时名称占位 JJDGuard Agent Platform、版本占位 1.0.0；正式包由 .env 注入平台版本，不复用引擎 VERSION。
PRODUCT_NAME=
PRODUCT_VERSION=
# 默认 gateway=false、agent-platform=true；显式 false 始终优先。
# AGENT_ENDPOINT_ENABLED=false

# gateway-core API 入站读取保护：请求头保持短窗口，完整请求体允许慢链路长上下文上传。
# 完整读取超时不得低于 5m；非法、非正值、低于 5m 或不大于请求头超时时回退 10s/5m。
GATEWAY_HTTP_READ_HEADER_TIMEOUT=10s
GATEWAY_HTTP_READ_TIMEOUT=5m
GATEWAY_API_BODY_LIMIT_MB=200

# 可信代理源 IP：填写所有反向代理跳的精确 CIDR（优先单机 /32），逗号分隔。
# 留空时忽略所有 X-Forwarded-For/X-Real-IP，防止客户端伪造来源。
#
# 多层代理（例如 客户端 -> 客户侧代理 -> 本网关正向代理 -> gateway-core）：
#   必须把链路上每一跳代理的 IP 都列进来，缺一跳就会把那一跳误判成真实
#   客户端。取源 IP 的规则是「从 TCP 对端往左，连续剥掉所有命中本白名单
#   的跳，返回第一个不在白名单里的地址」。
#   例：TRUSTED_PROXY_CIDRS=10.0.0.5/32,192.168.31.7/32
#       XFF=<真实客户端>,192.168.31.7  且 TCP 对端=10.0.0.5 → 取到真实客户端。
#       若只填 10.0.0.5/32，则会错误地把 192.168.31.7 当成客户端。
#
# 只影响审计/留证的源 IP 采集，不参与任何拦截决策。
TRUSTED_PROXY_CIDRS=

# 双层代理（客户 PC -> 本正向代理 -> 客户出网代理 -> 互联网）。
# 留空 = 不启用，正向代理直连出网（默认）。
# 启用写法必须带端口，例：UPSTREAM_EGRESS_PROXY=http://10.20.30.40:8080
#
# 语义与边界：
#   - 只对配置的这一个 host:port 开精确豁免。其余内网地址仍被 SSRF 防线挡住，
#     不是放开整个网段；同 IP 的别的端口也不放。
#   - 云元数据地址（169.254.0.0/16 等）永不豁免，即使写进这里也不生效。
#   - 出网走 CONNECT 隧道，隧道目标仍受白名单裁决并照常留证——多一跳不会绕开审计。
#   - 上层代理拒绝时报错，不会静默退回直连（静默直连会让你以为流量走了出网代理）。
#   - 值非法（缺端口、非 http/https）时 proxy-server 启动失败，属有意为之。
UPSTREAM_EGRESS_PROXY=

# Gateway forward proxy: deny unlisted tenant targets, or allow blind tunnels
# with a coverage gap. Audit-only always prevents policy enforcement.
GATEWAY_FORWARD_PROXY_MODE=deny_unlisted
# Both forward proxies: whitelist lookup errors closed rejects, open allows
# with a gap. Only proxy-server treats a successfully empty list as allowed
# with a configuration gap; gateway deny_unlisted still rejects empty lists.
PROXY_WHITELIST_FAIL_MODE=closed

# Detection pool or queue overflow: false records a gap, true rejects in Protect.
# SECURITY_AUDIT_ONLY=true always permits traffic regardless of this setting.
SECURITY_CAPACITY_FAIL_CLOSED=false

# Ordinary proxy detector failure: open permits with a gap; closed rejects in Protect.
PROXY_DETECTION_FAIL_MODE=open

# Required for provider credential encryption/decryption.
JJD_PROVIDER_SECRET_KEY=replace-with-a-long-random-secret

# Required for audit chain integrity. Use a long random value in production.
UAG_AUDIT_HMAC_KEY=change-me-long-random-hmac-key

# Shared secret used only by gateway/control-plane internal APIs.
JJD_INTERNAL_API_SECRET=replace-with-a-long-random-internal-secret

# Dedicated secret for MCP confirmation exact-once identity and encrypted replay results.
# Required when MCP_GATEWAY_ENABLED=true and must contain at least 32 bytes.
# It has no provider/internal secret fallback and must not reuse another credential.
MCP_CONFIRMATION_SCOPE_SECRET=

# Gateway semantic projection attestation. Shared only by control-plane and
# gateway-core; never reuse the internal API or rule-pack attestation secret.
JJD_SEMANTIC_GATEWAY_ATTESTATION_KEY=

# Dedicated credential shared only by security-engine and bundled Tier-1.
JJD_TIER1_INTERNAL_TOKEN=

# Dedicated rule-pack attestation secret shared only by control-plane and
# security-engine. It must not reuse JJD_INTERNAL_API_SECRET.
JJD_RULE_PACK_ATTESTATION_TENANT=tenant_default
JJD_RULE_PACK_ATTESTATION_TOKEN=

# Optional multi-tenant control-plane map. The single-tenant variables above
# override the same normalized tenant when both are configured.
JJD_RULE_PACK_ATTESTATION_TOKENS_JSON=

# 生产建议 true：多租户管理接口无权限直接 403；false 仅用于迁移期 dry-run。
UAG_RBAC_ENFORCE=false

# 网关回连 LSE 的精确 origin 列表，逗号分隔；为空时 fail-closed。
LSE_BASE_URL_ALLOWLIST=

# LSE 关联证据 HMAC：keyring 使用 kid=secret，required 模式下无签名/验签失败的 X-LSE-* 不入可信证据。
LSE_CORRELATION_HMAC_KEYS=
LSE_CORRELATION_HMAC_MODE=off
LSE_CORRELATION_HMAC_MAX_SKEW_SECONDS=300

# ===== AgentShield 联动：网关对外 HTTPS 地址（只有 control-plane 读取）=====
# AgentShield 通过 control-plane 的 /admin/v1/integration/upstreams 拉取出口清单，
# 接口用下面两项告诉它：客户端应经哪个网关地址访问大模型。
# GATEWAY_PUBLIC_BASE_URL：客户端能访问到的网关主地址，必须以 https:// 开头，
#   例如 https://gateway.company.example 或 https://10.0.0.8:443。
#   地址里的查询串和用户名密码会被丢弃，不要在里面放 Token。
#   留空或填 http:// 时，该接口固定返回 503 gateway_public_url_unavailable，
#   AgentShield 拉不到出口清单，三产品联动里的出口识别随之失效。
# GATEWAY_PUBLIC_ALIASES：同一网关的其他 HTTPS 地址（内网 IP、VPN 域名、证书里的主机名等），
#   逗号分隔；不是 https:// 的条目会被忽略。
# 这两项与 chat 段的 GATEWAY_PUBLIC_URL（员工门户展示的调用地址）、控制台「对外调用地址」
# （system_settings.gateway_public_base_url）互不读取，需要分别配置。修改后重建 control-plane 生效。
GATEWAY_PUBLIC_BASE_URL=
GATEWAY_PUBLIC_ALIASES=

# chat-portal 门户集成通道（/admin/v1/portal-integration/*）专用共享密钥。
# 留空 = 门户通道关闭（该组端点返回 503），对其他功能零影响；启用时填长随机值。
# 与 JJD_INTERNAL_API_SECRET 相互独立、无 fallback，勿复用同一凭据。
JJD_PORTAL_API_SECRET=

# Customer installations enable metering by default. Priced requests reserve
# their allowance and any financially configured prepaid wallet, then settle
# actual usage. Exhausted monetary quotas return HTTP 429; unpriced models pass
# without a monetary charge and leave an auditable unpriced usage fact.
# off disables accounting; prepaid requires a wallet for priced requests.
# Frontend images also read BILLING_ENABLED and must be rebuilt when it changes.
BILLING_ENABLED=true
BILLING_MODE=metering
BILLING_CUSTOMER_GROUP=default
BILLING_DEFAULT_CURRENCY=CNY
BILLING_TIMEZONE=Asia/Shanghai
# 请求执行租约上限；仅用于异常中断后的并发槽自动回收，不影响 RPM 统计窗口。
BILLING_REQUEST_LEASE_TTL=35m
BILLING_REDEMPTION_PREFIX=JJD

# X-Security-Action: blank follows the effective runtime mode, Protect on and Record off.
# Explicit true exposes action metadata to data-plane clients, including in Record mode.
SECURITY_ACTION_HEADER_ENABLED=

# Required bootstrap admin credentials for first deployment.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Published service ports. Change these when the host already uses the defaults.
WEB_PORT=3000
WEB_HTTPS_PORT=443
GATEWAY_PORT=8080
PROXY_PORT=8082
CONTROL_PORT=8081
SECURITY_PORT=8000
FORWARD_PROXY_PORT=3128
POSTGRES_PORT=5432
REDIS_PORT=6379

# Deployment record lock: true force-locks record (audit-only) mode; the console
# cannot switch to protect and no policy blocks. Keep false for customer installs:
# a fresh database already starts in record mode (no blocking) and the operator
# turns on blocking by switching the console to protect. Do not set true just to
# get "no blocking by default"; that makes protect unreachable without editing .env.
SECURITY_AUDIT_ONLY=false
# Skill admission lookup failures: closed requires confirmation (or blocks if
# no confirmation channel exists); open forwards and records a coverage gap.
# The deployment audit-only lock always prevents enforcement.
SKILL_ADMISSION_FAIL_MODE=closed
# MCP target policy refresh failures: closed rejects in protect mode; open
# preserves existing blocks and otherwise forwards with a coverage gap.
MCP_POLICY_FAIL_MODE=open
# Inspect tool returns for indirect injection using the security engine.
MCP_TOOL_RESULT_GUARD_ENABLED=true
SECURITY_PII_CHECKSUM_ENABLED=true
SECURITY_LLM_JUDGE_MODE=off

# Responses/Chat 输出安全处理档位；audit-only 仍只留证，不会被该档位绕过。
GATEWAY_OUTPUT_SECURITY_MODE=stream_enforce

# 文件内容 DLP：唯一真源是系统设置里的全局开关（默认关闭，控制台热生效，无需重启）。
# 此环境变量仅在控制平面不可用时作启动后备，默认 false；控制平面动态值始终优先。
SECURITY_FILE_CONTENT_DLP_ENABLED=false

# ===== 误报治理 =====
# 校验位失败即丢弃（默认开）：银行卡 Luhn / 身份证 GB11643 校验不过的正则命中不再产生
# finding（几乎必是流水号/时间戳/遥测 ID）。置 false 回退旧行为（保留 finding、置信度 0.3）。
#SECURITY_PII_CHECKSUM_DROP_INVALID=true
# 编码流量降级（默认关）：AI IDE/CLI 编码流量里，系统命令/env 文件/通用 API key 等规则
# 按降级表就地降 severity（只降不升，原值记 severity_original，hard_floor 永不降级）。
#SECURITY_CODING_TRAFFIC_DOWNGRADE_ENABLED=true
# 遥测端点免送检（默认开）：request_decoder=telemetry 的端点（如 Copilot 打点域）不再送
# security-engine 检测，留证照常。置 false 恢复全量送检。
#PROXY_TELEMETRY_SCAN_EXEMPT=true
# 收件箱整源抑制：命中列表的 matched_summary.source（逗号分隔）不进告警收件箱，
# security_events 留证不受影响；hard_floor 命中恒穿透。评测流量建议整源挡出：
#SECEVENT_INBOX_SUPPRESS_SOURCES=llm_safety_eval
# 标记误报→同组静默天数（默认 30，0=关闭）：告警组处置为误报后，同组后续事件
# 在有效期内不进收件箱/不通知；留证照常，hard_floor 与拦截动作恒穿透。
#SECEVENT_FP_DISPOSITION_SUPPRESS_DAYS=30
# 单规则日聚合阈值（默认 0=关闭）：同一规则当日告警超过 N 条后转每日聚合摘要卡，
# 不再逐条进收件箱（每规则每日至多一条外部通知）。建议 20。
#SECEVENT_RULE_DAILY_LIMIT=20
# 告警提升 grace 秒（默认 0）：给异步 AI 复核标注留落地时间再提升，建议 30。
#SECEVENT_ALERT_GRACE_SECONDS=30
# secret 首见告警（默认关）：同一密钥指纹流向已见过的目的地时静默累计，
# 首次流向新目的地才告警；仅正向代理路径参与，hard_floor 密钥恒逐条。
#SECEVENT_SECRET_NOVELTY_ENABLED=true

# ===== 语义攻击检测（越狱/角色扮演/指令覆盖/数据外泄诱导）=====
# observe-only：命中只审计+告警，绝不拦截。默认全关，按需开启。
#
# full 包（自带 CPU 语义裁判 llm-judge 容器，Qwen3-4B-Instruct-2507，零外部依赖）——取消下面注释启用：
#   SECURITY_SEMANTIC_ENABLED=true
#   SECURITY_SEMANTIC_INPUT_ENABLED=true        # 输入侧语义检测
#   SECURITY_SEMANTIC_AGENT_ENABLED=true        # Agent 工具调用语义检测（gateway-core 侧，P3）
#   SECURITY_LLM_JUDGE_URL=http://llm-judge:8080/v1/chat/completions
#   SECURITY_LLM_JUDGE_MODEL=bundled-judge
#   SECURITY_LLM_JUDGE_API_KEY=bundled-judge
#   SECURITY_SEMANTIC_TOTAL_TIMEOUT=8           # ②(+③) 总时长硬限（秒），fail-open
#
# lite 包（无自带模型）：把 SECURITY_LLM_JUDGE_URL 指向客户中转/本地的 OpenAI 兼容端点即可。
SECURITY_SEMANTIC_ENABLED=false
SECURITY_SEMANTIC_INPUT_ENABLED=false
SECURITY_SEMANTIC_AGENT_ENABLED=false
SECURITY_LLM_JUDGE_URL=http://127.0.0.1:8091/v1/chat/completions
SECURITY_LLM_JUDGE_MODEL=qwen2.5-7b-instruct-local
SECURITY_LLM_JUDGE_TIMEOUT=8
SECURITY_LLM_JUDGE_API_KEY=local-test-key

# ===== MCP 安全网关 =====
# MCP 服务代理与工具调用权限管控（gateway-core :8080 的 /mcp/{serverID}，默认关）。
# 开启后 tools/call 按「租户/项目/用户/密钥/智能体/会话 × 服务 × 工具」六元组策略判定，
# 并内置参数红线检测（云元数据/私钥外传/破坏性命令）。
# 仍受 SECURITY_AUDIT_ONLY 钳制：audit-only 下任何策略/红线命中只审计留痕、绝不阻断。
MCP_GATEWAY_ENABLED=false
# MCP Streamable 会话登记表：memory（默认，单副本）| redis（多副本部署必须用 redis，否则 initialize 与后续请求落到不同副本会被判为未知会话）。
#MCP_SESSION_STORE=memory
# record 模式下重复的纯红线 security_events 折叠窗口（Go duration，默认 10m；0 = 关闭折叠、逐条写）。首次命中一定写完整事件，tool_call_logs 不受影响。
#MCP_REDLINE_EVENT_DEDUPE_WINDOW=10m
MCP_ALLOWED_ORIGINS=

# ===== 响应缓存（redis-cache 独立实例）=====
# 与限流/预算/会话所用的 redis 分开部署：不落盘、不挂卷、不发布端口，满了按最近最少使用淘汰。
# 密码复用 REDIS_PASSWORD。缓存实例不可用时网关按未命中处理，不影响启动和 /health。
# 内存上限，valkey 的 maxmemory 写法（如 256mb、1gb）；默认 256mb。
#RESPONSE_CACHE_MAXMEMORY=256mb

# ===== Tier-1 攻击概率初筛级联 + 误报压制（observe-only，默认全关）=====
# Tier-0 rules and Tier-1 scores select bounded contextual judge work.
# Low-score shortcuts remain available; every effective verdict requires the judge.
#
# full 包（自带 tier1-classifier 容器，自训开源融合分类器：多语 embedder + LR 头，
# 许可 MIT/Apache，零 gated、零 Llama 许可传导，可随产品交付客户）——取消下面注释启用：
#   SECURITY_TIER1_ENABLED=true
#   SECURITY_FP_SUPPRESSION_ENABLED=true        # 误报压制：LLM 确认 likely_false_positive 的意图类规则命中不进收件箱(仍留 security_events)
#
# Thresholds guide admission and priority. High Tier-1 scores never directly emit findings.
#
# tier1-classifier 的 ONNX 推理线程数（intra_op_num_threads）。留空 = 跟随
# ENGINE_RESOURCE_EFFECTIVE_TIER1_THREADS（engine-resource-autotune.sh 按 CPU 档位写入），
# 再回落默认 2。多核客户机可显式调高（如 4/8）提升 Tier-1 打分吞吐。
TIER1_EXECUTION_PROVIDER=cpu
#TIER1_THREADS=2
# 单次 session.run 的滑窗上限（峰值内存旋钮）。留空 = 用满 TIER1_MAX_TOKEN_WINDOWS，
# 行为与原来一致（长文本本来就是一次图执行）；它只限制峰值内存，不提升吞吐。
#TIER1_BATCH_WINDOWS=16
# CPU profile image used by tier1-scale.sh cpu <replicas> --apply.
TIER1_CPU_IMAGE=docker-compose-tier1-classifier:latest
# 下面的 CPU/GPU 档位旋钮是【覆盖项】，不是默认值：留空/注释 = 跟随
# engine-resource-autotune.sh 写入的档位（large = TIER1_WORKERS 4、
# TIER1_INFERENCE_WORKERS 8、TIER1_INFERENCE_CAPACITY 256）。
# 一旦在这里写死，会盖掉 autotune 的档位，供需校验也会跟着失真：
# 引擎按 8x256 打在途，sidecar 实际只有 2x16，满载时 tier1 返 503 并被判成降级。
#TIER1_CPU_THREADS=
#TIER1_CPU_WORKERS=
#TIER1_CPU_INFERENCE_WORKERS=
#TIER1_CPU_INFERENCE_CAPACITY=
# GPU profile requires a separately reviewed onnxruntime-gpu image pinned by digest.
TIER1_GPU_IMAGE=
TIER1_GPU_COUNT=1
# CUDA 的 intra-op 线程固定 1；并发同样跟随 autotune，不要在这里写死。
TIER1_GPU_THREADS=1
#TIER1_GPU_WORKERS=
#TIER1_GPU_INFERENCE_WORKERS=
#TIER1_GPU_INFERENCE_CAPACITY=
SECURITY_TIER1_ENABLED=false
SECURITY_TIER1_URL=http://tier1-classifier:8000/classify
SECURITY_TIER1_TIMEOUT=1.0
# 0.2 是出厂保守值，低于 compose 兜底 0.30：阈值越低越多窗口进判官，
# 召回不掉、成本更高。调高前先跑语料对比（docs/deployment-capacity.md 第 5 节）。
SECURITY_TIER1_LOW_THRESHOLD=0.2
SECURITY_TIER1_HIGH_THRESHOLD=0.8
# legacy | coverage_v2; coverage_v2 admits low-score windows with risk cues.
SECURITY_SEMANTIC_CASCADE_POLICY=legacy
SECURITY_FP_SUPPRESSION_ENABLED=false
TLS_ENABLED=true
TLS_CERT_HOSTS=localhost,127.0.0.1

# Optional upstream keys. Configure only when you want to call those providers directly.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional runtime bootstrap for first usable environment.
DEFAULT_PROVIDER_NAME=
DEFAULT_PROVIDER_TYPE=openai
DEFAULT_PROVIDER_BASE_URL=
DEFAULT_PROVIDER_API_KEY=
DEFAULT_KEY_PROJECT_ID=project_default
DEFAULT_KEY_USER_ID=user_admin
DEFAULT_KEY_SCOPES=["chat","responses","embeddings","models"]

# Offline enterprise license. Offline bundles fill these automatically.
JJD_LICENSE_ENFORCE=false
JJD_LICENSE_PUBLIC_KEY=
# 续费正式授权验签公钥环（keyId=base64url 裸公钥，逗号分隔多个）。续费 license 为 v2 需要它。
JJD_LICENSE_PUBLIC_KEYS=lse-lic-2026=WxiAqCV0BUqVnopcPSrOWcVlowUoz1JQtGyEUCZ2f_Y

# Optional database overrides if you do not use the default compose values.
POSTGRES_USER=jjdguard
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=jjdguard

# ===== AD/LDAP 目录 LDAPS 证书信任 =====
# 客户目录的 CA 证书（PEM）放进：deploy/docker-compose/directory-truststore/
# 放一次即可，两个消费者同时生效：
#   - 目录预览 / 连接测试（control-plane，DIRECTORY_TRUST_DIR）
#   - 目录全量同步 FullSync（内置身份引擎，KC_TRUSTSTORE_PATHS）
# 放好后重启这两个服务：
#   sh compose-wrapper.sh up -d --force-recreate control-plane chat-idp
# 说明：
#   - 只接受 CA 证书；放进去的服务器叶子证书会被忽略（不会被当成信任根）。
#   - 目录为空 = 没有额外可信根，仍然做完整证书校验，不是跳过校验。
#   - 自签目录证书必须把签发它的根 CA 放进来，不能只放服务器证书本身。

# ===== chat 门户模块（仅 chat 包；base 包无此段，装机自动生成密钥）=====
# 包内含 deploy/docker-compose/chat/ 载荷 = chat 包，deploy-offline 检测到即自动追加 chat profile
# 并生成 CHAT_POSTGRES_PASSWORD/AUTH_SECRET/各 OIDC secret/JJD_PORTAL_API_SECRET/CHAT_OIDC_ISSUER。
# Chat 与 SSO 不再单独发布 3100/8280/8180；统一复用 Web 的公开 origin：
#   员工门户 /chat，身份协议 /sso，门户管理 /portal。
# issuer 主机：浏览器与门户服务端须解析到同一 Web 入口。缺省 = 本机探测 IP；有内网域名建议改主机名。
# 容器侧经宿主 Web 端口 hairpin 回访 issuer；少数关闭 hairpin 的环境，请把
# CHAT_OIDC_HOST 设为可从容器内解析到宿主的内网 DNS 名。
#CHAT_OIDC_HOST=
# JJDGuard 公共 origin（应与 Web 控制台一致；不要带 /chat 或 /sso 路径）：
#JJD_SSO_PUBLIC_URL=https://guard.company.example
# 客户和员工可访问的模型网关 origin（不要带 /v1），例如 https://gateway.company.example：
GATEWAY_PUBLIC_URL=
# 仅隔离内网验收时可显式允许 HTTP，生产保持 false：
#JJD_SSO_ALLOW_INSECURE_PUBLIC_URL=false
#CHAT_REALM=jjdguard
#CHAT_OIDC_ISSUER=https://guard.company.example/sso/realms/jjdguard
#CHAT_PORTAL_UI_OIDC_CLIENT_ID=enterprise-ai-portal
# 任务10：enterprise-sso provider 的服务端固定 Keycloak kc_idp_hint（指向企业目录 IdP）。
#CHAT_PORTAL_UI_OIDC_ENTERPRISE_IDP_HINT=enterprise
# 只接企业 SSO、没有 AD/LDAP 本地目录账号的站点设为 false：隐藏并停用 Chat 登录页的「企业目录账号登录」入口
# （该入口不带 IdP 提示，会落在内置身份服务自己的账号密码页，输入企业用户名会得到 user_not_found）。默认 true。
#CHAT_PORTAL_UI_OIDC_ACCOUNT_LOGIN_ENABLED=true
# 旧版直连 IdP 兼容模式：置 true 则不启用内置身份运行服务，须另填 CHAT_OIDC_ISSUER / CHAT_PORTAL_UI_OIDC_CLIENT_ID / CHAT_PORTAL_UI_OIDC_SECRET。
#CHAT_BYO_IDP=false
# 品牌可覆盖：
#BRAND_NAME=企业 AI 对话门户
#BRAND_ACCENT=#2451eb

# 检测实例资源预算（不是产品QPS上限）；容量含执行中与排队任务。
# 单机保留默认服务名；多节点可改为客户检测集群的负载均衡地址。
SECURITY_ENGINE_URL=http://security-engine:8000
# 检测进程数（uvicorn workers，默认 1）。检测受单进程 GIL 限制，线程再多也只用 1 核，
# 并发过高会让规则预算超时。>1 时每个 worker 是独立进程：熔断器、成功率窗口、缓存、
# file_id_registry、ToolDefinitionPinner（app/detectors/agent_guard.py）都是进程内状态，
# 不跨进程共享。建议同时把 SECURITY_INPUT_WORKERS / SECURITY_OUTPUT_WORKERS 设为 2。
# Commented out = written by engine-resource-autotune.sh from the detected CPU
# tier. Uncomment to set an explicit override; autotune never overwrites it.
#SECURITY_ENGINE_WEB_CONCURRENCY=1
#SECURITY_INPUT_WORKERS=2
SECURITY_INPUT_CAPACITY=32
SECURITY_INPUT_BUDGET_SECONDS=30
# 整笔网关输入请求的检测共享预算，覆盖缓存重放、附件预检和批量扫描。
GATEWAY_INPUT_SECURITY_REQUEST_TIMEOUT=45s
SECURITY_ENGINE_TIMEOUT=40s
SECURITY_OUTPUT_WORKERS=2
SECURITY_OUTPUT_CAPACITY=32
SECURITY_OUTPUT_BUDGET_SECONDS=30
SECURITY_BATCH_MAX_ITEMS=128
SECURITY_BATCH_BUDGET_SECONDS=18
# 以下调优项留空即用代码默认值，需要时去掉注释再改。
# 单个 batch 内同时检测的条目数（默认 2；检测受单进程 GIL 限制，调大只会增加规则超时）。
#SECURITY_BATCH_ITEM_CONCURRENCY=2
# 自定义正则预算按检测线程 CPU 时间计（单条 / 整包 / 长内容上限），整包墙钟上限兜底。
#SECURITY_CUSTOM_REGEX_RULE_SECONDS=0.01
#SECURITY_CUSTOM_REGEX_PACK_SECONDS=0.05
#SECURITY_CUSTOM_REGEX_RULE_MAX_SECONDS=0.2
#SECURITY_CUSTOM_REGEX_PACK_MAX_SECONDS=0.5
#SECURITY_CUSTOM_REGEX_PACK_WALL_MAX_SECONDS=3
#SECURITY_CATALOG_BUDGET_SECONDS=2
#SECURITY_CATALOG_REGEX_TIMEOUT_SECONDS=0.25
# 正则因等待 CPU 超时后的单次重试：墙钟 = 剩余 CPU 预算 × SLACK，封顶 WALL_MAX 秒。
#SECURITY_REGEX_WALL_SLACK=10
#SECURITY_REGEX_WALL_MAX_SECONDS=2
# 网关对 batch 未完成条目单条恢复的首次退避（Go duration），第二轮 ×3，抖动 ±50%。
#GATEWAY_SECURITY_RETRY_BACKOFF=200ms
# 每个 security-engine 进程的窗口并发；客户按单机/集群容量填写正整数，无产品硬上限。
# 未单独设置以下两个可选项时，裁判线程数和调用容量跟随窗口并发。
SECURITY_SEMANTIC_WINDOW_PARALLELISM=4
#SECURITY_JUDGE_WORKERS=4
#SECURITY_JUDGE_CAPACITY=4
# 排队数量和等待秒数由部署配置，所有等待仍共享本次请求的总预算。
SECURITY_JUDGE_QUEUE_CAPACITY=8
SECURITY_JUDGE_QUEUE_WAIT=3
SECURITY_JUDGE_REGULAR_QUEUE_WAIT=3
SECURITY_JUDGE_QUEUE_CALL_RESERVE=1
# CPU 裁判资源由离线安装/升级按主机内存和 CPU 自动分档。需要完全手工控制时，
# 设置 JUDGE_RESOURCE_PROFILE=manual，并配置 JUDGE_MEMORY_LIMIT、
# JUDGE_MEMORY_RESERVATION、JUDGE_MEMORY_SWAP_LIMIT、JUDGE_CACHE_RAM_MB、
# JUDGE_PARALLEL、JUDGE_CTX、JUDGE_THREADS、JUDGE_BATCH_SIZE、JUDGE_UBATCH_SIZE。
# 也可指定 lab / small / standard / large / xlarge 强制采用对应内存档位。
#JUDGE_RESOURCE_PROFILE=auto
# security-engine worker pools are sized by engine-resource-autotune.sh from the
# host CPU tier (ENGINE_RESOURCE_PROFILE=auto). SECURITY_JUDGE_GLOBAL_CONCURRENCY
# defaults to 96. ENGINE_RESOURCE_*_EFFECTIVE_* and ENGINE_RESOURCE_PROFILE_*
# records are generated by the tuner on every install/upgrade: do not edit them
# by hand. Set ENGINE_RESOURCE_PROFILE=manual to keep every value operator-managed.
#ENGINE_RESOURCE_PROFILE=auto
#SECURITY_JUDGE_GLOBAL_CONCURRENCY=96
#
# Multi-replica deployment: docker compose -f docker-compose.yml -f docker-compose.scale.yml up -d
# (offline bundle: use docker-compose.offline.yml as the base). Requires Docker Compose >= 2.24.4.
#SECURITY_ENGINE_REPLICAS=2
# Replicas share state over the existing valkey service (DB 3, key prefix jjd:se:).
# With SECURITY_SHARED_STATE_REQUIRED=true a missing valkey is fail-closed and the
# engine refuses to boot; every degradation is audited through /health, /metrics,
# inspection_reason and semantic_status. Never set REQUIRED=false in production.
#SECURITY_SHARED_STATE_REQUIRED=true
# Per-command socket timeout. Measured on loopback at 256 in-flight: p99 14.9ms,
# worst sample 43.9ms, i.e. roughly 1.1x headroom at the default 0.05s. A single
# command timing out only rejects NEW file scans (503) and is audited; text
# detection never goes through admission. Raise to 0.2 on large/xlarge hosts.
#SECURITY_SHARED_STATE_TIMEOUT=0.05
# Single instance defaults to the stable id security-engine:primary. Leave it
# blank only for multi-replica stacks (the scale overlay forces blank); blank
# derives hostname#pid so each replica is distinct.
#SECURITY_NODE_ID=
# Semantic judge window. 1200/200 is the measured default; do not widen it
# without re-running the dilution benchmark. Measured on a 4B judge over real
# 4000+ char bodies: 1200/200 hits 49/100 embedded hardcases with 5/100 false
# positives, while 4000/300 hits only 30/100 (0/100 FP). Each 4000-char prompt
# also grows from 1842 to 2849 tokens, so total judge time only halves.
#SECURITY_SEMANTIC_WINDOW_CHARS=1200
#SECURITY_SEMANTIC_WINDOW_OVERLAP=200
# Tier-1 SSRF allowlist: only these hosts/ports may be called by the engine.
#SECURITY_TIER1_ALLOWED_HOSTS=tier1-classifier
#SECURITY_TIER1_ALLOWED_PORTS=8000
# tier1 replicas / CUDA provider: use tier1-scale.sh <cpu|gpu> <replicas> --apply
# Commented out = written by engine-resource-autotune.sh from the CPU tier;
# uncomment to override explicitly (autotune never overwrites an explicit value).
#SECURITY_TIER1_MAX_INFLIGHT=1
SECURITY_TIER1_CLIENT_WORKERS=4
SECURITY_TIER1_CLIENT_CAPACITY=32
SECURITY_SEMANTIC_MAX_WINDOWS=32
# tier1 推理并发同样是覆盖项：写死会顶掉 engine-resource-autotune.sh 的档位
# （large = 8/256），引擎按 8x256 打在途、sidecar 只有 1x8，满载 503 被判成降级。
# 留空/注释 = 跟随档位。
#TIER1_INFERENCE_WORKERS=
#TIER1_INFERENCE_CAPACITY=
# 扩容拓扑：tier1-scale.sh --apply 成功后写入，必须保留 —— 升级、回滚、
# 重新装机与 engine-resource-autotune.sh 都靠这两个键重建 tier1。
# 留空 = 未扩容（基础 compose、单副本）。`tier1-scale.sh reset --apply` 会清空。
#TIER1_SCALE_MODE=
#TIER1_REPLICAS=1
# 引擎副本数（多副本时需求侧按它翻倍）：demand = 副本 x WEB_CONCURRENCY x
# SECURITY_TIER1_MAX_INFLIGHT，supply = TIER1_REPLICAS x TIER1_WORKERS x
# TIER1_INFERENCE_CAPACITY，两侧都用 deploy/docker-compose/tier1-topology.sh。
#SECURITY_ENGINE_REPLICAS=1
TIER1_INFERENCE_TIMEOUT_SECONDS=1.0
TIER1_MAX_TOKEN_WINDOWS=16
GATEWAY_OUTPUT_STREAM_HOLDBACK_BYTES=256
GATEWAY_OUTPUT_STREAM_SCAN_BATCH_BYTES=1024
GATEWAY_OUTPUT_STREAM_PENDING_BYTES=4194304
GATEWAY_OUTPUT_STRICT_MAX_BYTES=4194304

# Per-request window fan-out; unset inherits shared window parallelism.
# SECURITY_SEMANTIC_REQUEST_PARALLELISM=4

# Additional direct tunnel suffixes are logged and audited as a coverage gap.
PROXY_MITM_BYPASS_SUFFIXES=
# Explicit plaintext diagnostic directory; blank keeps capture disabled.
PROXY_RAW_DUMP_DIR=
