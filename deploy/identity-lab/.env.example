# =====================================================================
# identity-lab 测试口令与密钥（隔离测试用，绝对不可用于生产）
# 本文件是示例模板，所有值都是 lab-only 占位；真实密钥请另存为 .env（已被 .gitignore 忽略）。
# 严禁把真实口令/密钥提交入库，严禁把 lab 口令用于任何生产部署。
# =====================================================================

# OpenLDAP 管理员口令（lab-only 占位）
LDAP_ADMIN_PASSWORD=lab-ldap-admin-only

# LDAP federation bind（JJDGuard Keycloak → OpenLDAP，复用 admin）
LDAP_BIND_CREDENTIAL=lab-ldap-admin-only

# OpenLDAP test users (lab-only placeholders)
LDAP_ALICE_PASSWORD=lab-ldap-alice-only
LDAP_BOB_PASSWORD=lab-ldap-bob-only
LDAP_CAROL_PASSWORD=lab-ldap-carol-only
LDAP_DAVE_PASSWORD=lab-ldap-dave-only

# Samba AD 域管理员口令（lab-only 占位）
SMB_DOMAIN_PASS=Lab-AD-Domain-Admin-Only!42
SMB_DOMAIN_NAME=ad.jjdguard-lab.test
SMB_DOMAIN_DN=DC=ad,DC=jjdguard-lab,DC=test
AD_BIND_CREDENTIAL=Lab-AD-Domain-Admin-Only!42
AD_BOB_PASSWORD=lab-ad-bob-only
AD_DISABLED_PASSWORD=lab-ad-disabled-only

# Keycloak 管理员（两个 Keycloak 复用，lab-only 占位）
KEYCLOAK_ADMIN_USER=lab-kc-admin
KEYCLOAK_ADMIN_PASSWORD=lab-kc-admin-only
KEYCLOAK_TLS_PASSWORD=lab-keystore-only

# JJDGuard realm 本地账号（lab-only 占位）
LOCAL_ADMIN_PASSWORD=lab-local-admin-only
LOCAL_ALICE_PASSWORD=lab-local-alice-only

# OIDC / broker client secret（lab-only 占位，绝不入真实部署）
PORTAL_OIDC_CLIENT_SECRET=lab-portal-client-secret-only
ENTERPRISE_BROKER_CLIENT_SECRET=lab-enterprise-broker-secret-only
IDENTITY_RUNTIME_CLIENT_SECRET=lab-identity-runtime-secret-only
JJD_IDENTITY_RUNTIME_ALLOWED_URLS=https://jjdguard-keycloak:8443/sso
DIRECTORY_RUNTIME_CLIENT_SECRET=lab-directory-runtime-secret-only
DIRECTORY_RUNTIME_ALLOWED_URLS=https://jjdguard-keycloak:8443/sso

# Enterprise OIDC test users (lab-only placeholders)
ENTERPRISE_ERIN_PASSWORD=lab-enterprise-erin-only
ENTERPRISE_FRANK_PASSWORD=lab-enterprise-frank-only
ENTERPRISE_CAROL_PASSWORD=lab-oidc-carol-only

# Isolated control-plane and Portal runtime (lab-only placeholders)
IDENTITY_LAB_DB_PASSWORD=lab-control-plane-db-only
CONTROL_PLANE_ADMIN_USERNAME=admin
CONTROL_PLANE_ADMIN_PASSWORD=lab-control-plane-admin-only
CONTROL_PLANE_ADMIN_NEW_PASSWORD=lab-control-plane-admin-rotated-only
JJD_PORTAL_API_SECRET=lab-portal-api-secret-only
JJD_PROVIDER_SECRET_KEY=lab-provider-secret-encryption-only
PORTAL_AUTH_SECRET=lab-portal-auth-secret-only
PORTAL_INTERNAL_TOKEN=lab-portal-internal-token-only
